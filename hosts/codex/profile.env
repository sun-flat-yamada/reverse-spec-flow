# profile.env — OpenAI Codex CLI（GP-107 ルール3。IDE 拡張・クラウドは別の面で、ここに含めない）
#
# 読むのは `init.sh` と手順書の記入者だけ。**ゲートは読まない**（GP-107 ルール4）。
# **何も実測していない**（MEASURED.md）。値は配置の設計で決まるものだけを書き、ホストの挙動は unknown のままにする。
# 公式文書で読んだ挙動（skill の探索場所・AGENTS.md の連結）は entry.md と MEASURED.md に「文書による」と書いて区別する。

# --- 識別 ---
HOST_SURFACE=codex
MEASURED_VERSION=unknown           # 実測していない
SUPPORT_LEVEL=placed-unverified    # 配置しただけ。完走・スモークとも未実施

# --- 配置物（apply-host.sh がホストを切り替えたとき、前のホストの残りとして示す。HOST.md / HOST-SETUP.md は共通部分（hosts/_place-common.sh）が置くので書かない）---
PLACED_PATHS=".agents/skills"

# --- 入口文書 ---
ENTRY_DOCS=agents-md               # 配置の設計（ベンダ固有の入口を置かず AGENTS.md だけにする）を書いたもので、読まれ方の実測ではない（entry.md §1）
NESTED_ENTRY_AUTOLOAD=unknown      # 文書では「ルートから CWD までの AGENTS.md を連結する」。開いただけで読むかは未実測

# --- skill ---
SKILLS=unknown                     # 文書では native（.agents/skills/ を探す）。発動は未実測
SKILLS_DIR=.agents/skills          # Agent Skills の標準の場所。CWD からリポジトリのルートまでを探す（文書）

# --- サブエージェント ---
SUBAGENT=unknown
SUBAGENT_PARALLEL=unknown
SUBAGENT_MAX_CONCURRENT=unknown
SUBAGENT_ARTIFACT_LEAK=unknown
SUBAGENT_TOOL_RESTRICT=unknown     # 読み取りを解析対象の配下に制限する手段は見つかっていない（entry.md §5）

# --- 解析対象（ワークスペース外）へのアクセス ---
SOURCE_IN_WORKSPACE=no             # SB-5 を配置で担保する（解析対象をワークスペースに入れない）
HOST_SEARCH_SCOPE=unknown
SOURCE_SCAN=unknown
SOURCE_READ=unknown

# --- 実行 ---
SHELL_TIMEOUT_DEFAULT=unknown
OUTPUT_LIMIT=unknown
UNATTENDED=unknown

# --- フック ---
HOOKS=none                         # 使っていない
